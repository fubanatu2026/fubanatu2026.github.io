<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prowise Board Diashow</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
        }
        .slide {
            display: none;
            width: 100%;
            height: 100%;
            border: none;
            position: absolute;
            top: 0;
            left: 0;
        }
        img.slide {
            object-fit: contain; /* Zeigt das Bild voll an. Nutze 'cover' für absolut randlos */
            width: 100%;
            height: 100%;
        }
        .active {
            display: block;
        }
    </style>
</head>
<body>

    <!-- SCHRITT 1: Erste Webseite (20 Sekunden) -->
    <iframe class="slide active" src="https://tournifyapp.com/live/fubanatu2026-stufe-5-6-maennlich/present" data-duration="20000"></iframe>

    <!-- SCHRITT 2: Das Bild (10 Sekunden) -->
    <img class="slide" src="bild.jpg" data-duration="10000" alt="Bild">

    <!-- SCHRITT 3: Zweite Webseite (20 Sekunden) -->
    <iframe class="slide" src="https://w3schools.com" data-duration="20000"></iframe>

    <!-- SCHRITT 4: Das gleiche Bild noch einmal (10 Sekunden) -->
    <img class="slide" src="bild.jpg" data-duration="10000" alt="Bild">

    <script>
        const slides = document.querySelectorAll('.slide');
        let currentSlide = 0;

        function runDiashow() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');

            const duration = parseInt(slides[currentSlide].getAttribute('data-duration'), 10);
            setTimeout(runDiashow, duration);
        }

        const firstDuration = parseInt(slides[currentSlide].getAttribute('data-duration'), 10);
        setTimeout(runDiashow, firstDuration);
    </script>
</body>
</html>
